DATABASE_URL=postgres://platform:platform@localhost:5438/platform
APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
# Generated by pnpm setup. No default production password.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
ATTACHMENT_DIR=.data/attachments
MAX_ATTACHMENT_BYTES=20971520
# Also used by Send email; the trigger inbox domain must be verified for outbound sending.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Exact origins only. Add your client API origin before publishing tools.
TOOL_ALLOWED_ORIGINS=http://localhost:4010,http://mock-api:4010
# Explicit development exceptions; leave empty for production.
TOOL_ALLOW_PRIVATE_ORIGINS=http://localhost:4010,http://mock-api:4010
MOCK_API_URL=http://localhost:4010/receipts
